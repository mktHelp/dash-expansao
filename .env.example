# ===== Planilha =====
# ID da planilha "Relatório COF" (trecho da URL entre /d/ e /edit) e o gid da aba
# "Qualificação COF 2026" (número depois de gid= na URL).
GOOGLE_SHEET_ID=
GOOGLE_SHEET_GID=0

# Só com o ID acima, o painel lê a planilha pela exportação CSV do Google
# (funciona enquanto ela estiver compartilhada como "Qualquer pessoa com o link").
#
# Para manter a planilha PRIVADA, use uma conta de serviço (Leitor na planilha):
# GOOGLE_SERVICE_ACCOUNT_EMAIL=dash-bf@seu-projeto.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_SHEET_RANGE="'Qualificação COF 2026'!A:Z"

# ===== Funil ao vivo (/funil) =====
# Aba "Ao Vivo" da mesma planilha. Padrão: gid 1336244876 (CSV) e range 'Ao Vivo'!A:Z (conta de serviço)
# FUNIL_SHEET_GID=1336244876
# FUNIL_SHEET_RANGE='Ao Vivo'!A:Z
# Meta de vendas (reserva ou taxa de franquia)
# META_VENDAS=10

# ===== Campanha =====
# Meta = linhas com "Presença Confirmada" = Sim
META_PRESENCA=100
# Data e hora do evento (contagem regressiva)
# NEXT_PUBLIC_EVENT_AT=2026-11-27T19:00:00-03:00
# Recorde compartilhado do alarme (Upstash Redis). Sem isso, cada tela conta o
# próprio relógio no navegador. A integração Upstash da Vercel cria estas duas
# variáveis sozinha (também aceita UPSTASH_REDIS_REST_URL / _TOKEN).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Senha da página /telao (manda uma imagem para o centro de todas as telas).
# Sem ela o telão fica fechado. Precisa do Redis acima.
# TELAO_SENHA=
# Alarme de inatividade: minutos sem presença / convite NOVO até o alerta aparecer
# NEXT_PUBLIC_ALERTA_PRESENCA_MIN=5
# NEXT_PUBLIC_ALERTA_CONVITE_MIN=5
# Expediente (Brasília) e dias (0 = dom … 6 = sáb): fora dele o relógio pausa
# NEXT_PUBLIC_EXPEDIENTE=08:00-18:00
# NEXT_PUBLIC_DIAS_EXPEDIENTE=1,2,3,4,5
# Início da corrida: antes dele não há "vs ontem" nem setas no ranking (visão completa)
# NEXT_PUBLIC_CAMPAIGN_START=2026-11-05T00:00:00-03:00
# NEXT_PUBLIC_BLACK_FRIDAY_DAY=2026-11-27

# Sem GOOGLE_SHEET_ID o painel roda em MODO DEMO com dados fictícios.
