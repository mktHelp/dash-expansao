# ===== Planilha =====
# ID da planilha "Relatório COF" (trecho da URL entre /d/ e /edit) e o gid da aba
# "Qualificação COF 2026" (número depois de gid= na URL).
GOOGLE_SHEET_ID=
GOOGLE_SHEET_GID=0

# Só com o ID acima, o painel lê a planilha pela exportação CSV do Google
# (funciona enquanto ela estiver compartilhada como "Qualquer pessoa com o link").
#
# Para manter a planilha PRIVADA, use uma conta de serviço (Leitor na planilha):
# GOOGLE_SERVICE_ACCOUNT_EMAIL=dash-bf@seu-projeto.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_SHEET_RANGE="'Qualificação COF 2026'!A:Z"

# ===== Campanha =====
# Meta = linhas com "COF Enviada" = Sim entre 01/11 e 30/11
META_COF=200
# Início da corrida: antes dele não há "vs ontem" nem setas no ranking
# NEXT_PUBLIC_CAMPAIGN_START=2026-11-05T00:00:00-03:00
# NEXT_PUBLIC_CAMPAIGN_END=2026-11-30T23:59:59-03:00
# NEXT_PUBLIC_BLACK_FRIDAY_DAY=2026-11-27

# Sem GOOGLE_SHEET_ID o painel roda em MODO DEMO com dados fictícios.
